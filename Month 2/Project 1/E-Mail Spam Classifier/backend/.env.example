# Backend Environment Variables Template (Placeholders only)

# [MANDATORY] Supabase Managed PostgreSQL Database URL
# Direct connection (port 5432) or Session Pooler (port 5432 / 6543)
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth Configuration (Backend JWT Verification)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Encryption at rest for Gmail OAuth tokens (32-byte URL-safe base64 Fernet key)
TOKEN_ENCRYPTION_KEY=your_32_byte_url_safe_base64_fernet_key=

# Flask Session signing key for OAuth PKCE state
FLASK_SECRET_KEY=your_random_flask_secret_key

# Google OAuth Credentials JSON (Raw JSON string from GCP Console)
GOOGLE_CREDENTIALS_JSON={"web":{"client_id":"...","project_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_secret":"..."}}

# Application URLs
FRONTEND_URL=https://your-frontend-app.vercel.app
BACKEND_URL=https://your-backend-api.onrender.com

# Google Cloud Pub/Sub Push Webhook
PUBSUB_TOPIC_NAME=projects/[GCP-PROJECT-ID]/topics/gmail-watch
# Cron secret for automated Gmail watch renewals (POST /api/gmail/cron/renew)
CRON_SECRET=your_secure_random_cron_secret_token_here

# ----------------------------------------------------
# Frontend Environment Variables Template (.env on Vercel)
# ----------------------------------------------------
# VITE_BACKEND_URL=https://your-backend-api.onrender.com
# VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_public_anon_key
