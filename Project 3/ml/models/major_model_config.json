    "negative_records": 410,
    "input_features": [
        "Age",
        "Sex",
        "ChestPainType",
        "RestingBP",
        "Cholesterol",
        "FastingBS",
        "RestingECG",
        "MaxHR",
        "ExerciseAngina",
        "Oldpeak",
        "ST_Slope"
    ],
    "excluded_input_columns": [
        "Cholesterol_Missing"
    ],
    "preprocessing": [
        "Median imputation for numerical missing values",
        "StandardScaler for numerical features",
        "OneHotEncoder for categorical features",
        "FastingBS passed through as a binary feature"
    ],
    "model_parameters": {
        "n_estimators": 700,
        "max_depth": 20,
